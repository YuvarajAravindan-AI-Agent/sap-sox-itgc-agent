{
  "name": "sap-sox-itgc-agent",
  "version": "0.1.0",
  "description": "SOX 404 / ITGC evidence agent for SAP (USA): deterministic control tests, hash-chained audit, offline-verifiable evidence",
  "private": true,
  "dependencies": {
    "@sap/cds": "^8",
    "express": "^4",
    "@sap/xssec": "^4",
    "@cap-js/hana": "^1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8.9.19"
  },
  "scripts": {
    "seed": "node seed/generate.js",
    "test": "node test/seed.test.js && node test/chain.test.js && node test/ac01.test.js && node test/ac01-service.test.js && node test/e2e.test.js",
    "start": "cds-serve"
  },
  "cds": {
    "requires": {
      "db": {
        "[production]": {
          "kind": "hana"
        },
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      },
      "auth": {
        "[production]": {
          "kind": "xsuaa"
        },
        "[development]": {
          "kind": "mocked",
          "users": {
            "agent": {
              "password": "agent",
              "roles": [
                "agent"
              ]
            },
            "auditor": {
              "password": "auditor",
              "roles": [
                "auditor"
              ]
            }
          }
        }
      }
    },
    "sql": {
      "native_hana_associations": false
    }
  }
}
