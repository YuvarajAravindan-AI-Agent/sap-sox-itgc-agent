namespace sox;

using { cuid } from '@sap/cds/common';

// SAP-shaped, synthetic data. Column names are readable; the comment on each entity names the SAP table it mirrors, so the
// control tests can later be pointed at a customer's S/4HANA through a destination with a mapping layer.
// Synthetic means: every row is generated by seed/generate.js, with planted, countable exceptions listed in seed/manifest.json.

// USR02 (user master).
entity Users {
  key userId : String(12);
  fullName   : String(60);
  department : String(30);
  userType   : String(12);   // DIALOG | SERVICE | FIREFIGHTER
  locked     : Boolean;
  lastLogon  : Date;
  validTo    : Date;
}

// AGR_USERS (role assignment with validity).
entity RoleAssignments {
  key userId : String(12);
  key role   : String(30);
  validFrom  : Date;
  validTo    : Date;
}

// AGR_1251 (authorization objects and activities granted by a role).
entity RoleAuthorizations {
  key role       : String(30);
  key authObject : String(20);
  key activity   : String(4);
}

// Business meaning of an (authorization object, activity) pair. Part of the SoD ruleset.
entity Capabilities {
  key capability : String(30);
  authObject     : String(20);
  activity       : String(4);
  privileged     : Boolean;   // counts as privileged for the dormant-user test
  description    : String(120);
}

entity SodRules {
  key ruleId  : String(10);
  capabilityA : String(30);
  capabilityB : String(30);
  riskLevel   : String(10);
  description : String(160);
}

// Approved compensating controls for a specific user and rule, with a validity window.
entity MitigatingControls {
  key ID      : String(12);
  userId      : String(12);
  ruleId      : String(10);
  description : String(160);
  approvedBy  : String(12);
  validFrom   : Date;
  validTo     : Date;
}

// T001B (posting periods): closedAt is the date the period was closed to postings.
entity PostingPeriods {
  key fiscalYear : Integer;
  key period     : Integer;
  closedAt       : Date;
}

// ACDOCA (S/4HANA universal journal; earlier BKPF/BSEG). Two lines per document in the synthetic data.
entity JournalLines {
  key docNumber : String(10);
  key lineItem  : Integer;
  companyCode   : String(4);
  fiscalYear    : Integer;
  period        : Integer;
  postingDate   : Date;
  entryDate     : Date;
  postedBy      : String(12);
  source        : String(12);   // MANUAL | SUBLEDGER
  account       : String(10);
  debitCredit   : String(1);    // D | C
  amount        : Decimal(15, 2);
  currency      : String(3);
  reviewedBy    : String(12);
  reviewedAt    : Date;
}

// E070 (transport requests) joined to an ITSM export of change tickets.
entity Transports {
  key trkorr   : String(12);
  owner        : String(12);
  targetSystem : String(3);     // DEV | QAS | PRD
  releasedAt   : Date;
  priority     : String(10);    // NORMAL | EMERGENCY
  ticketId     : String(12);
  description  : String(120);
  reviewedBy   : String(12);    // post-implementation review (emergency changes)
  reviewedAt   : Date;
}

entity ChangeTickets {
  key ticketId : String(12);
  requester    : String(12);
  approver     : String(12);
  status       : String(12);    // DRAFT | APPROVED
  approvedAt   : Date;
}

// A named control owner's conclusion on one run. The agent cannot create these (separate scope), and each one is also an audit row.
entity Signoffs : cuid {
  controlId          : String(20);
  runSeq             : Integer;        // audit seq of the runControl row this concludes on
  runHash            : String(64);     // that row's hash, so a changed run cannot keep its sign-off
  signedBy           : String(120);    // authenticated user, never taken from the request body
  signedAt           : Timestamp;
  conclusion         : String(12);     // EFFECTIVE | NOT_EFFECTIVE
  exceptionsReviewed : Boolean;
  comment            : String(1000);
  auditSeq           : Integer;        // seq of the signOffControl audit row
}

// Tamper-evident audit trail, same shape as the sap-gov-sandbox one (srv/audit.js, srv/chain.js).
entity AuditLog : cuid {
  timestamp     : Timestamp;
  correlationID : String(80);
  outcome       : String(10);   // OK | DENIED | ERROR
  httpStatus    : Integer;
  caller        : String(120);
  tool          : String(60);
  input         : LargeString;
  output        : LargeString;
  endUser       : String(120);
  dataVersion   : String(64);
  asOf          : Timestamp;
  ruleVersion   : String(60);
  schemaVersion : Integer;
  seq           : Integer;
  prevHash      : String(64);
  hash          : String(64);
  reconciliation: String(12);
}
